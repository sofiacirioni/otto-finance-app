# Copiar a .env.local (ignorado por git) y completar con los datos del proyecto.
# Supabase → Project Settings → API Keys / Data API.
# Solo la publishable key: es pública por diseño. NUNCA poner acá la secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
